# Copy this file to .env and edit the values.
MQTT_BROKER=mqtt.example.lan
MQTT_PORT=1883
# Meshtastic default-style encrypted message topic; adjust to your broker's topic layout.
MQTT_TOPIC=msh/+/2/e/+/+
MQTT_USERNAME=
MQTT_PASSWORD=
# Channel PSK used to decrypt protobuf (/e/) traffic. "default" is the public
# Meshtastic key; use base64:.../hex/simpleN for a private channel, or "none".
MQTT_PSK=default
# Full URL copied from Discord channel Settings > Integrations > Webhooks.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/WEBHOOK_ID/WEBHOOK_TOKEN
# Per-message Discord avatar. {seed} and {color} are filled per node; set empty to disable.
DISCORD_AVATAR_URL_TEMPLATE=https://api.dicebear.com/9.x/initials/png?seed={seed}&backgroundColor={color}&size=128&fontWeight=600
# Where learned node names are stored inside the container (persisted by compose).
NODE_DB_PATH=/data/nodes.json
LOG_LEVEL=INFO
# Docker image tag. Keep in sync with the VERSION file (see README "Versioning").
APP_VERSION=0000.00.00.0
